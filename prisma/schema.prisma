generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Client {
  id             String     @id @default(cuid())
  name           String
  description    String?    // 品牌簡介：帶入品牌記憶，生圖/文案時作品牌背景參考
  industry       String?    // 品牌產業
  fonts              String     @default("[]")  // 常用字體 JSON string[]
  primaryColor   String
  secondaryColor String?
  logoUrl        String?
  logoUrls           String     @default("[]")  // 多版本品牌 logo：JSON [{url,label}]，放置標誌時可選版本
  toneLabels         String     @default("[]")
  taboos             String     @default("[]")  // [WIP/素材庫] 保留
  commonText         String     @default("")    // [COLLEAGUE] 合併新增
  pastPostImageUrls  String     @default("[]")
  paletteColors      String     @default("[]")  // [WIP/素材庫] 保留
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  activities     Activity[]
  marketingPlans MonthlyMarketingPlan[]  // [PLANNER] AI 月度企劃
}

model Activity {
  id                   String            @id @default(cuid())
  clientId             String
  client               Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  theme                String
  focusPoint           String
  titleText            String?           // [COLLEAGUE] 畫面上必放的主標題文字
  subtitleText         String?           // [COLLEAGUE] 畫面上必放的副標題文字
  imagePrompt          String?           // [COLLEAGUE] 使用者描述的腦中畫面 prompt
  productImageUrl      String            @default("")   // [COLLEAGUE] backward compat (first image)
  productImageUrls     String            @default("[]") // [COLLEAGUE] 最多 5 張（JSON array）
  referenceImageUrls   String            @default("[]")
  selectedComponentIds String            @default("[]") // [COLLEAGUE] 選取的風格組件 IDs
  imageRatio           String            @default("1:1") // [COLLEAGUE] 圖片比例
  customW              Int               @default(0)     // 輸出寬（px）；0=用比例預設。同產品圖一致嘅尺寸設定
  customH              Int               @default(0)     // 輸出高（px）；0=用比例預設
  imageModel           String            @default("google/gemini-3-pro-image-preview") // [COLLEAGUE] 生圖模型
  baseImageUrl         String?           // [2b] 底圖模式：成張相 100% 做背景，唔重新生圖；null=行現有生圖流程
  typographyMood       String?           // [2b] 特效字風格 override（auto/luxury/cozy/noble/fresh）；null/auto=Gemini 綜合底圖+品牌+主題自選
  layoutId             String            @default("single")  // [MULTI] 多圖版型 id（single = 單圖）
  genMode              String            @default("unified") // [MULTI] 生成模式：unified（統一主題）| perCell（各圖獨立）
  cells                String            @default("[]")      // [MULTI] 各格資料 JSON: [{description, mustText, assetUrls[]}]
  logoMode             String            @default("first")   // [MULTI] LOGO 位置：first | all | none
  variantCount         Int               @default(1)         // [MULTI] 統一主題生成幾組（1 或 2＝A導購+B敘事；2 暫時關閉，Vercel Hobby 逾時風險，留返升級 Pro 先重開）
  variantChoice        String            @default("A")       // [MULTI] variantCount=1 時揀嘅單組款式：A｜B
  errorMessage         String?           // [MULTI] 生成失敗時的真正錯誤原因（顯示在 UI，免翻 log）
  status               String            @default("PENDING")
  createdAt            DateTime          @default(now())
  generatedLayouts     GeneratedLayout[]
  plannerItem          ContentPlanItem?  @relation("GeneratedActivity")  // [PLANNER] 由某篇 Topic 生成而來（反向關聯）
}

model GeneratedLayout {
  id              String   @id @default(cuid())
  activityId      String
  activity        Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  layoutType      String
  imageUrl        String
  copyText        String
  styleComponents String   @default("{}")
  isSelected      Boolean  @default(false)
  textBurnedIn    Boolean  @default(false)  // [COLLEAGUE] 文字是否已由 AI 燒入圖片
  savedToLibrary  Boolean  @default(false)  // [COLLEAGUE] 是否已加入素材庫（策展）
  textLayerJson   String   @default("{}")   // [2b] 底圖模式：交俾後續文字排版階段嘅文字層 JSON
  cellImageUrls   String   @default("[]")   // [MULTI] 多圖拼版：各格子圖 URL（供日後個別編輯）
  effectLevel     String?                   // 底圖模式（BASE-1/2/3）文字視覺處理：plain/effect/styled，隨機分配，供 LayoutPicker 顯示真正差異
  createdAt       DateTime @default(now())
}

model StyleComponent {
  id             String   @id @default(cuid())
  name           String
  type           String
  data           String   @default("{}")
  sourceLayoutId String
  clientId       String?
  aiPromptText   String   @default("")
  previewUrl     String?
  createdAt      DateTime @default(now())
}

model LibraryImage {
  id           String   @id @default(cuid())
  clientId     String?
  imageUrl     String   @default("")
  prompt       String   @default("")
  copyText     String?
  subject      String?
  paramsJson   String   @default("{}")
  status       String   @default("DONE")  // PENDING｜GENERATING｜DONE｜FAILED（舊資料一律當 DONE）
  errorMessage String?                     // 生成失敗時嘅真正原因（顯示喺 UI，免翻 log）
  batchId      String?                     // 同一次「生成 N 張」嘅群組 id，畫廊用嚟顯示「批次 x/N」
  createdAt    DateTime @default(now())
}

// ── AI 月度企劃（Monthly Marketing Planner）────────────────────────────────────
// 來源：功能包「AI月度行銷企劃-獨立功能包」。流程以 Flow A 為準，
// 完整對映見 docs/monthly-planner-flow-A-spec.md、docs/monthly-planner-trend-signals-spec.md。
// 生成沿用既有 Activity 管線（ContentPlanItem.generatedActivity），不做獨立批次器。

model MonthlyMarketingPlan {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  year           Int
  month          Int
  goals          String   @default("[]")   // JSON string[]：行銷目標
  totalPostCount Int      @default(12)      // 本月預計篇數
  platforms      String   @default("[]")   // JSON string[]：Instagram / Facebook
  status         String   @default("DRAFT") // DRAFT→STRATEGY_READY→TOPICS_READY→GENERATION_READY→REVIEW→COMPLETED
  strategyJson   String   @default("{}")    // AI 內容策略（summary + contentMix + campaignAllocations）
  signalsJson    String   @default("[]")    // [TREND-SIGNALS] 本次規劃收集到的外部趨勢訊號快照（可空）
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  campaigns      MarketingCampaign[]
  contentItems   ContentPlanItem[]

  @@unique([clientId, year, month])
  @@index([clientId, updatedAt])
}

model MarketingCampaign {
  id             String   @id @default(cuid())
  monthlyPlanId  String
  monthlyPlan    MonthlyMarketingPlan @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)
  name           String
  startDate      DateTime
  endDate        DateTime
  goals          String   @default("[]")
  description    String   @default("")
  sortOrder      Int      @default(0)
  allocationJson String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  products       CampaignProduct[]
  importantDates CampaignImportantDate[]
  contentItems   ContentPlanItem[]

  @@index([monthlyPlanId, sortOrder])
}

model CampaignProduct {
  id         String   @id @default(cuid())
  campaignId String
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  label      String
  imageUrl   String
  sourceKind String   @default("library")  // library＝從素材庫選；upload＝使用者自行上傳
  sourceId   String?                        // sourceKind=library 時對應 LibraryImage.id
  createdAt  DateTime @default(now())

  @@index([campaignId])
}

model CampaignImportantDate {
  id         String   @id @default(cuid())
  campaignId String
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date       DateTime
  label      String
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@index([campaignId, date])
}

model ContentPlanItem {
  id                   String   @id @default(cuid())
  monthlyPlanId        String
  monthlyPlan          MonthlyMarketingPlan @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)
  campaignId           String?
  campaign             MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contentType          String   // BRAND｜EDUCATION｜PRODUCT｜ENGAGEMENT｜PROMOTION
  topic                String
  contentDirection     String   @default("")
  recommendationReason String   @default("")   // [TREND-SIGNALS] 為何本月推這個 topic（② 每篇的短理由）
  sourceSignals        String   @default("[]") // [TREND-SIGNALS] JSON：[{ id, source, label, score }]，引用了哪些訊號
  format               String   @default("SINGLE")  // SINGLE｜CAROUSEL
  platforms            String   @default("[]")
  scheduledDate        DateTime?                     // ③ 內容日曆拖曳寫入
  status               String   @default("PLANNING") // PLANNING→DRAFT→GENERATING→NEEDS_REVIEW→APPROVED
  sortOrder            Int      @default(0)
  generatedActivityId  String?  @unique
  generatedActivity    Activity? @relation("GeneratedActivity", fields: [generatedActivityId], references: [id], onDelete: SetNull)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([monthlyPlanId, sortOrder])
  @@index([campaignId])
  @@index([scheduledDate])
}
