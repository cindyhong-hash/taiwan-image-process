# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Local database & uploads
prisma/dev.db
prisma/dev.db-shm
prisma/dev.db-wal
public/uploads/

# Claude Code local config (never push)
.claude/settings.local.json
.claude/launch.json

# local backups
.backup/
*.pre-merge-bak
prisma/dev.db.pre-merge-bak

# packed material bundles (pack-materials.sh)
dist/
