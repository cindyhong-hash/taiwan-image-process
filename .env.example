# ── marketing-tool 環境變數範本 ──
# 複製成 .env.local 並填入真實值（.env.local 不會 commit）。
# 換電腦後：建立 .env.local、填 key/token，再跑 prisma migrate + generate。

# 本機 SQLite 資料庫
DATABASE_URL="file:./prisma/dev.db"

# 活動流程舊文案 route（目前未用，可留佔位）
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# OpenRouter — 圖片分析(vision) + 生成文案
# 取得：https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxx"
# model id 會輪換/下架；若 analyze/generate 回 404，去 https://openrouter.ai/api/v1/models 揾現存平價 model 替換
OPENROUTER_VISION_MODEL="openai/gpt-4o-mini"
OPENROUTER_TEXT_MODEL="openai/gpt-4o-mini"

# ── fal.ai — 圖片生成/合成主力（text→image、產品合成、Nano Banana）──
# 取得：https://fal.ai/dashboard/keys
FAL_KEY=""
# 以下全部係「選填」model override：唔填就用 code 內預設值。
# fal model id 會輪換/改版；去對應 model 頁面 copy 返當下確切 id 再覆寫。
# Nano Banana：有參考圖 → edit（風格遷移）；冇參考圖 → text-to-image（純文字生圖）。
# FAL_EDIT_MODEL="fal-ai/nano-banana/edit"      # nano-banana 圖生圖（風格遷移/合成）
# FAL_NANO_T2I_MODEL="fal-ai/nano-banana"       # nano-banana 純文字生圖（無參考圖時用）
# FAL_FLUX2_EDIT_MODEL="fal-ai/flux-2-pro/edit" # FLUX.2 pro 合成（中文字保真主力）
# FAL_FLUX2_MODEL="fal-ai/flux-2-pro"           # FLUX.2 pro 真人寫實 text→image
# FAL_SEEDREAM_EDIT_MODEL="fal-ai/bytedance/seedream/v4.5/edit"
# FAL_QWEN_EDIT_MODEL / FAL_RECRAFT_MODEL / FAL_REMBG_MODEL / FAL_UPSCALE_MODEL 同理

# 圖片生成後端：inapp（OpenRouter 文字 + Pollinations/HF 圖片）或 n8n（webhook，目前 stub）
GEN_PROVIDER="inapp"
# N8N_WEBHOOK_URL=""

# 圖片生成 token（in-app 模式）
# 主力建議用 HF（穩定、免費）；POLLINATIONS_TOKEN 留空時會直接行 HF
# Hugging Face 免費 token：https://huggingface.co/settings/tokens（建 Read token，hf_ 開頭）
HF_TOKEN=""
# 圖片生成 model（HF）；端點固定用 router.huggingface.co/hf-inference/models/<此值>
HF_IMAGE_MODEL="black-forest-labs/FLUX.1-schnell"
# 選填：Pollinations token（console https://enter.pollinations.ai ，credit 制）
# 注意：免費匿名/部分 IP 會回 402，故預設留空、直接行 HF
POLLINATIONS_TOKEN=""
